# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Connection (Use MongoDB Atlas for production)
MONGODB_URI=mongodb://localhost:27017/blood_donation_db
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/blood_donation_db

# Session Secret (Generate a strong secret for production)
SESSION_SECRET=your-super-secret-session-key-change-in-production

# JWT Secret (if using JWT authentication)
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Render.com auto-sets this in production
# RENDER_EXTERNAL_URL=https://your-app.onrender.com
